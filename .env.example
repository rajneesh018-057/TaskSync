# ==============================================================================
# TaskSync Environment Configuration Template
# ==============================================================================

# Server Port
PORT=5050

# JWT Authentication Secret
JWT_SECRET="RajnishSecretJWTTokenKey2026"

# ------------------------------------------------------------------------------
# Redis Cache & Distributed Rate Limiting Configuration (Port 6379)
# ------------------------------------------------------------------------------
# In Docker Compose, redis is automatically accessed at: redis://redis:6379
# On host machine:
#   - Connect to local Redis: redis://localhost:6379
# If omitted or Redis is down, server automatically falls back to in-memory store
REDIS_HOST_PORT=6379
REDIS_URL="redis://localhost:6379"

# Redis Key Isolation Prefix (prevents collision with other apps on port 6379)
REDIS_KEY_PREFIX="tasksync:"




DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/tasksync?schema=public"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/tasksync?schema=public"

# ------------------------------------------------------------------------------

GROQ_API_KEY=""

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (Optional - for Google Login & Calendar Sync)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
